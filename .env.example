# Copy to .env and fill in only what you need. Real environment variables take
# precedence over values in this file.

# Required for `incident-analyzer fetch` (a read-only REST API key is sufficient).
PAGERDUTY_API_TOKEN=
# Override for PagerDuty EU accounts: https://api.eu.pagerduty.com
PAGERDUTY_BASE_URL=https://api.pagerduty.com

# Required for `incident-analyzer classify`.
OPENAI_API_KEY=
# Any OpenAI-compatible chat model, including a fine-tuned model ID.
INCIDENT_ANALYZER_LLM_MODEL=gpt-4o-mini

# Directory holding incidents_raw.csv / incidents_categorized.csv (default: ./data/sample).
INCIDENT_ANALYZER_DATA_DIR=

# Dashboard bind address.
INCIDENT_ANALYZER_HOST=127.0.0.1
INCIDENT_ANALYZER_PORT=8050
